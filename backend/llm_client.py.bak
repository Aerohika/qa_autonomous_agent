# llm_client.py
# Development stub: no real Gemini call, so the backend cannot crash because of LLM.

def generate_test_cases(context: str, user_query: str) -> str:
    """
    Return dummy test cases so the UI and flow work even without an LLM.
    """
    return (
        "### DUMMY Test Cases (local stub)\n\n"
        f"Context summary length: {len(context)} characters\n"
        f"User query: {user_query}\n\n"
        "- Test Case 1: Fill in all required fields and submit. Expect success message.\n"
        "- Test Case 2: Leave one required field blank and submit. Expect validation error.\n"
    )


def generate_selenium_script(context: str, test_case_text: str, html_source: str) -> str:
    """
    Return a simple Selenium script that just loads the HTML via data URL.
    You can later replace this with a real model-based generator.
    """
    # Avoid breaking triple-quoted string
    safe_html = html_source.replace('"""', '\\"""')

    return f'''import time
from selenium import webdriver
from selenium.webdriver.common.by import By

# This is a DUMMY script generated by a local stub, not by Gemini.
driver = webdriver.Chrome()

# Load the HTML we stored from checkout.html as a data URL
driver.get("data:text/html;charset=utf-8," + """{safe_html}""")

time.sleep(2)
print("Dummy Selenium script executed. Please replace with real selectors and actions.")
driver.quit()
'''
